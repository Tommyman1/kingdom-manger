# REQUIRED: generate with: openssl rand -hex 32
KM_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

KM_CHECK_SECONDS=300
KM_IDLE_CPU_PERCENT=3.0
KM_IDLE_MINUTES=20

# Optional reporting
DISCORD_WEBHOOK_URL=
KM_DASHBOARD_URL=https://kingdom-manager-tail.kingdom.local
DISCORD_MENTION_ROLE_ID=
DISCORD_NOTIFY_UPDATES=true
DISCORD_NOTIFY_RECOVERY=true
DISCORD_NOTIFY_SENSOR_FAILURES=true
N8N_WEBHOOK_URL=

# Existing ClamAV container on a network reachable by Kingdom Manager.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# CrowdSec Local API, example: http://crowdsec:8080
CROWDSEC_URL=
CROWDSEC_API_KEY=


FALCO_HOST=falco
FALCO_HEALTH_PORT=8765
TRIVY_AUTO_SCAN_ENABLED=true
TRIVY_AUTO_SCAN_EVERY_SECONDS=1800
TRIVY_AUTO_SCAN_START_DELAY_SECONDS=45
TRIVY_RESCAN_SECONDS=604800

# Notifications & reports
KM_NOTIFY_MIN_SEVERITY=high
KM_DAILY_REPORT_ENABLED=true
KM_DAILY_REPORT_HOUR=8
KM_WEEKLY_REPORT_WEEKDAY=0
KM_WEEKLY_REPORT_HOUR=9
KM_SCORE_HISTORY_INTERVAL_SECONDS=900

KM_RECOVERY_OBSERVATION_SECONDS=30
KM_RECOVERY_BLOCK_ON_CRITICAL_CVE=true
KM_RECOVERY_ALLOW_DATABASES=false

# Adaptive intelligence baseline tuning
KM_BASELINE_DAYS=7
KM_BASELINE_STABLE_MIN_EVENTS=100
KM_BASELINE_STABLE_MIN_HOURS=12
KM_BASELINE_STABLE_ATTENUATION=20
KM_BASELINE_LEARNING_ATTENUATION=8
KM_KNOWN_GOOD_RESIDUAL_RISK=5
KM_KNOWN_GOOD_MAX_ATTENUATION=45

# Kingdom 2.1 sensor reconciliation + playbook orchestration
KM_SENSOR_FAILURE_GRACE_SECONDS=120
KM_PLAYBOOKS_ENABLED=true
KM_PLAYBOOK_AUTO_EVIDENCE=true
KM_PLAYBOOK_AUTO_SCAN=true
KM_PLAYBOOK_AUTO_ISOLATE=false
KM_PLAYBOOK_AUTO_RECOVER=false
KM_IGNORE_HTTP_TRANSPORT_ERRORS=true

# Kingdom 3 update / rollback engine
KM_UPDATE_ENGINE_ENABLED=true
KM_UPDATE_CHECK_SECONDS=21600
KM_UPDATE_AUTO_APPLY=true
KM_UPDATE_ALLOW_STATEFUL=false
KM_ROLLBACK_RETENTION=10
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_STACK_ID=
KM_COMPOSE_SNAPSHOT_PATH=

# Kingdom 3.1 LTS hardening
KM_DRIFT_SCAN_ENABLED=true
KM_DRIFT_SCAN_SECONDS=1800
KM_BACKUP_MAX_AGE_HOURS=48
KM_AUTO_SAFE_PLAYBOOKS=true

# v3.1.1 reliability / performance
TRIVY_EXEC_DOCKER_HOST=tcp://trivy-exec-proxy:2375
KM_DOCKER_CACHE_TTL_SECONDS=12
KM_DOCKER_CACHE_MAX_STALE_SECONDS=300
KM_SENSOR_CACHE_TTL_SECONDS=15
KM_API_SNAPSHOT_TTL_SECONDS=10

# v3.1.3 warm-start / scheduler staggering
KM_DASHBOARD_REFRESH_SECONDS=15
KM_MONITOR_SCHEDULER_OFFSET_SECONDS=20
KM_SCORE_SCHEDULER_OFFSET_SECONDS=120
KM_TRIVY_SCHEDULER_OFFSET_SECONDS=420
KM_DRIFT_SCHEDULER_OFFSET_SECONDS=1140
KM_SENSOR_SCHEDULER_OFFSET_SECONDS=45
