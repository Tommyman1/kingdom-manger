TZ=America/New_York
DOCKER_HOST=tcp://socket-proxy:2375
DATABASE_PATH=/data/kingdom.db
ENABLE_MUTATIONS=false
IDLE_DEFAULT_SECONDS=900

# Optional. If omitted, Kingdom Manager generates /data/integration.key automatically.
# Never commit a real key to GitHub.
INTEGRATION_SECRET_KEY=
INTEGRATION_KEY_PATH=/data/integration.key

# Legacy v0.2 Jellyfin configuration. Prefer the v0.3 Integration UI.
JELLYFIN_API_KEY=
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_IDLE_SECONDS=1800
