# REQUIRED: generate with: openssl rand -hex 32
KM_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

KM_CHECK_SECONDS=300
KM_IDLE_CPU_PERCENT=3.0
KM_IDLE_MINUTES=20

# Optional reporting
DISCORD_WEBHOOK_URL=
N8N_WEBHOOK_URL=

# Existing ClamAV container on a network reachable by Kingdom Manager.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# CrowdSec Local API, example: http://crowdsec:8080
CROWDSEC_URL=
CROWDSEC_API_KEY=

# Optional Wazuh API endpoint/token
WAZUH_URL=
WAZUH_TOKEN=
